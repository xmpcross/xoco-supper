---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { siteConfig } from "@/config/site";
import { websiteSchema } from "@/lib/schema";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /**
   * The share card. Hand it an imported image — a post cover, a contributor
   * portrait — and it is cropped to card proportions at build time. A string
   * path is used as-is, for images that already live in `public/`.
   */
  image?: ImageMetadata | string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** Extra class on <body>. Used by the immersive article opening, which
      lifts the header onto the artwork. */
  bodyClass?: string;
  prevUrl?: string;
  nextUrl?: string;
  /** A section or contributor feed, advertised alongside the site-wide one. */
  feed?: { href: string; title: string };
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image,
  imageAlt,
  type = "website",
  noindex = false,
  bodyClass,
  prevUrl,
  nextUrl,
  feed,
  structuredData,
} = Astro.props;

/* Facebook, X, LinkedIn and Slack all crop to 1200x630, so the card is cut to
   that here rather than shipping a 4000px cover and letting each of them take a
   different slice of it.

   Both dimensions are clamped to the source, because Astro will not enlarge an
   image: asking for 1200x630 from something smaller returns whatever it could
   actually produce, and the `og:image:width` below would then be a number no
   scraper could verify. */
const cardRatio = 1200 / 630;
const cardSource = image && typeof image !== "string" ? image : undefined;
const cardWidth = Math.min(1200, cardSource?.width ?? 1200);
const cardHeight = Math.min(Math.round(cardWidth / cardRatio), cardSource?.height ?? 630);
const card = cardSource
  ? await getImage({
      src: cardSource,
      width: cardWidth,
      height: cardHeight,
      fit: "cover",
      position: "center",
      format: "jpeg",
      quality: 82,
    })
  : undefined;
const socialImage = card?.src ?? (typeof image === "string" ? image : siteConfig.socialImage);
const socialImageAlt = imageAlt ?? `${siteConfig.name} — ${siteConfig.tagline}`;

const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const absoluteImage = new URL(socialImage, siteConfig.siteUrl).toString();
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.name}`;
/* Every page says what the publication is; pages that are a *thing* — an
   article, a recipe — hand down their own graph instead. */
const schema = structuredData ?? websiteSchema();

// Optional: renders nothing once the file is deleted.
const BuyButton = Object.values(
  import.meta.glob<{ default: AstroComponentFactory }>("../components/BuyButton.astro", {
    eager: true,
  }),
)[0]?.default;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/young-serif/YoungSerif-Regular-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/figtree/Figtree-Variable-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {prevUrl && <link rel="prev" href={new URL(prevUrl, siteConfig.siteUrl).toString()} />}
    {nextUrl && <link rel="next" href={new URL(nextUrl, siteConfig.siteUrl).toString()} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS`} href={new URL("/rss.xml", siteConfig.siteUrl).toString()} />
    {
      feed && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={`${feed.title} RSS`}
          href={new URL(feed.href, siteConfig.siteUrl).toString()}
        />
      )
    }
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {
      card && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content={String(cardWidth)} />
          <meta property="og:image:height" content={String(cardHeight)} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      (() => {
        /*
         * Scroll reveals are CSS-only wherever view timelines exist. The
         * observer below is the fallback for everywhere else, so it stays off
         * when the browser can already do the work itself.
         *
         * This is the only inline script in the layout. There is no colour-mode
         * bootstrap because the theme has one mode — see the note at the top of
         * `src/styles/global.css`.
         */
        const root = document.documentElement;
        const hasViewTimeline =
          typeof CSS !== "undefined" &&
          typeof CSS.supports === "function" &&
          CSS.supports("animation-timeline: view()");
        const canReveal =
          !hasViewTimeline &&
          "IntersectionObserver" in window &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!canReveal) return;
        root.classList.add("can-reveal");

        window.addEventListener("DOMContentLoaded", () => {
          const revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                revealObserver.unobserve(entry.target);
              });
            },
            // Fire as soon as any part of the block enters, and reach 10%
            // past the bottom edge so a section sitting just under the fold has
            // already faded in by the time it is scrolled to. A percentage
            // threshold would hold tall sections back until a large slice of
            // them was on screen, which reads as content failing to load.
            { threshold: 0, rootMargin: "0px 0px 10% 0px" },
          );

          document
            .querySelectorAll(".reveal, .grid-tall > *, .rail > *, .trend-grid > *")
            .forEach((element) => revealObserver.observe(element));
        });
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    {BuyButton && <BuyButton />}
  </body>
</html>
