---
/**
 * The other half of the units switch. The stepper's toggle converts the
 * ingredient list, where an amount is a number and a unit; this converts the
 * amounts a recipe writes into a sentence — the oven in a step, "3cm thick",
 * "240ml of milk in the notes".
 *
 * It runs only on a page that carries the toggle, so a field note mentioning
 * 500g of pasta is never quietly rewritten under a reader with no way to
 * switch it back. The published wording is kept, so returning to the recipe's
 * own units is exact rather than a second rounding.
 */
---

<script>
  import { convertText, storedUnitSystem, UNITS_EVENT, type UnitSystem } from "@/config/recipe";

  if (document.querySelector("[data-units]")) {
    const skip = new Set(["CODE", "PRE", "KBD", "SAMP"]);
    const nodes: Text[] = [];

    document.querySelectorAll<HTMLElement>("[data-units-text]").forEach((root) => {
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode: (node) =>
          node.parentElement && skip.has(node.parentElement.tagName)
            ? NodeFilter.FILTER_REJECT
            : NodeFilter.FILTER_ACCEPT,
      });
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
    });

    const published = nodes.map((node) => node.data);

    const paint = (system: UnitSystem) =>
      nodes.forEach((node, index) => {
        const converted = convertText(published[index], system);
        if (node.data !== converted) node.data = converted;
      });

    document.addEventListener(UNITS_EVENT, (event) =>
      paint((event as CustomEvent<{ system: UnitSystem }>).detail.system),
    );
    paint(storedUnitSystem());
  }
</script>
