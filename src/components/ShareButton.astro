---
import LocalIcon from "@/components/LocalIcon.astro";

/**
 * Opens the page's `<ShareSheet>`. A page can carry several — the one in the
 * article hero and the one at the end of the reading — and they all drive the
 * single sheet the page rendered.
 */
interface Props {
  /** The `id` of the sheet this opens. */
  sheetId?: string;
  /**
   * `quiet`  an inline control, for a byline row
   * `button` an outlined button, for the end of an article
   */
  variant?: "quiet" | "button";
  label?: string;
  /** Set when the control sits on a photograph rather than on the page. */
  onImage?: boolean;
  class?: string;
}

const {
  sheetId = "share-sheet",
  variant = "quiet",
  label = variant === "button" ? "Share this article" : "Share",
  onImage = false,
  class: className = "",
} = Astro.props;
---

<button
  type="button"
  class:list={[
    variant === "button" ? "btn btn--line" : "share-inline",
    onImage && "share-inline--onImage",
    className,
  ]}
  aria-haspopup="dialog"
  aria-controls={sheetId}
  data-share-open
>
  <LocalIcon name="share" className="h-3.5 w-3.5" />
  <span>{label}</span>
</button>

<style>
  .share-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    background: none;
    padding: 0;
    color: var(--muted-foreground);
    cursor: pointer;
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.22s ease;
  }

  .share-inline:hover {
    color: var(--accent);
  }

  .share-inline--onImage {
    color: rgb(255 255 255 / 0.78);
  }

  .share-inline--onImage:hover {
    color: #fff;
  }
</style>
