---
import Icon from "@/components/ui/Icon.astro";

/**
 * Prints the page. Rendered hidden and revealed by the script below, because
 * without JavaScript the button could do nothing — a reader still has their
 * browser's own print command.
 */
interface Props {
  /**
   * `quiet`  an inline control, for the article hero
   * `button` an outlined button, for the recipe brief
   */
  variant?: "quiet" | "button";
  /** Set when the control sits on a photograph rather than on the page. */
  onImage?: boolean;
  class?: string;
}

const { variant = "quiet", onImage = false, class: className = "" } = Astro.props;
---

<button
  type="button"
  class:list={[
    variant === "button" ? "btn btn--line" : "print-inline",
    onImage && "print-inline--onImage",
    className,
  ]}
  data-print
  hidden
>
  <Icon name="printer" size={variant === "button" ? 15 : 14} />
  <span>Print</span>
</button>

<script is:inline>
  (() => {
    if (window.supperPrintWired) return;
    window.supperPrintWired = true;

    /* Revealed on DOM ready rather than here, so one copy of this script also
       reaches print buttons rendered after it in the document. */
    const init = () =>
      document.querySelectorAll("[data-print]").forEach((button) => (button.hidden = false));
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
    else init();

    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("[data-print]")) window.print();
    });
  })();
</script>

<style>
  .print-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 0;
    background: none;
    padding: 0;
    color: var(--muted-foreground);
    cursor: pointer;
    font-size: var(--fs-label);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.22s ease;
  }

  .print-inline:hover {
    color: var(--accent);
  }

  .print-inline--onImage {
    color: rgb(255 255 255 / 0.78);
  }

  .print-inline--onImage:hover {
    color: #fff;
  }
</style>
