---
import bluesky from "@/icons/bootstrap/bluesky.svg?raw";
import clipboard from "@/icons/bootstrap/clipboard.svg?raw";
import envelope from "@/icons/bootstrap/envelope.svg?raw";
import facebook from "@/icons/bootstrap/facebook.svg?raw";
import instagram from "@/icons/bootstrap/instagram.svg?raw";
import link45deg from "@/icons/bootstrap/link-45deg.svg?raw";
import linkedin from "@/icons/bootstrap/linkedin.svg?raw";
import mastodon from "@/icons/bootstrap/mastodon.svg?raw";
import pinterest from "@/icons/bootstrap/pinterest.svg?raw";
import reddit from "@/icons/bootstrap/reddit.svg?raw";
import rss from "@/icons/bootstrap/rss.svg?raw";
import share from "@/icons/bootstrap/share.svg?raw";
import telegram from "@/icons/bootstrap/telegram.svg?raw";
import threads from "@/icons/bootstrap/threads.svg?raw";
import threeDots from "@/icons/bootstrap/three-dots.svg?raw";
import tiktok from "@/icons/bootstrap/tiktok.svg?raw";
import twitterX from "@/icons/bootstrap/twitter-x.svg?raw";
import whatsapp from "@/icons/bootstrap/whatsapp.svg?raw";
import youtube from "@/icons/bootstrap/youtube.svg?raw";

const icons = {
  bluesky,
  clipboard,
  envelope,
  facebook,
  instagram,
  "link-45deg": link45deg,
  linkedin,
  mastodon,
  pinterest,
  reddit,
  rss,
  share,
  telegram,
  threads,
  "three-dots": threeDots,
  tiktok,
  "twitter-x": twitterX,
  whatsapp,
  youtube,
};

export type LocalIconName = keyof typeof icons;

interface Props {
  name: LocalIconName;
  className?: string;
}

const { name, className = "h-4 w-4" } = Astro.props;
const icon = icons[name];
---

<span
  class:list={[
    "inline-grid place-items-center [&>svg]:h-full [&>svg]:w-full [&>svg]:fill-current",
    className,
  ]}
  aria-hidden="true"
  set:html={icon}
/>
