{
  "name": "supper-astro-theme",
  "description": "An Astro recipe and food blog theme for one cook: scalable ingredient lists and a method you can tick off.",
  "type": "module",
  "version": "1.0.1",
  "author": "Andrei Alba",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "keywords": [
    "astro-theme",
    "astro",
    "food-blog",
    "recipe",
    "recipes",
    "cooking",
    "blog",
    "editorial",
    "tailwindcss"
  ],
  "homepage": "https://supper.xocoweb.workers.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/xocothemes/supper.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "release:check": "npm run check && npm run build && npm run format:check",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "overrides": {
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
